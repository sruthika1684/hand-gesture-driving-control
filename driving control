import cv2
import time
import numpy as np
import pyautogui
import mediapipe as mp
from threading import Thread
class VideoCaptureThread:
    def __init__(self, src=0):
        self.capture = cv2.VideoCapture(src)
        self.capture.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
        self.capture.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
        self.ret, self.frame = self.capture.read()
        self.running = True
        self.thread = Thread(target=self.update, daemon=True)
        self.thread.start()
    def update(self):
        while self.running:
            self.ret, self.frame = self.capture.read()
    def read(self):
        return self.ret, self.frame
    def release(self):
        self.running = False
        self.thread.join()
        self.capture.release()
mp_draw = mp.solutions.drawing_utils
mp_styles = mp.solutions.drawing_styles
mp_hand = mp.solutions.hands
camera = VideoCaptureThread()
previous_time = 0
with mp_hand.Hands(
    model_complexity=0,
    max_num_hands=1,
    min_detection_confidence=0.7,
    min_tracking_confidence=0.7
) as hand_tracker:
    while True:
        frame_read, video_frame = camera.read()
        if not frame_read:
            continue
        video_frame = cv2.flip(video_frame, 1)
        frame_height, frame_width, _ = video_frame.shape
        rgb_input = cv2.cvtColor(video_frame, cv2.COLOR_BGR2RGB)
        rgb_input.flags.writeable = False
        detection = hand_tracker.process(rgb_input)
        if detection.multi_hand_landmarks:
            for hand in detection.multi_hand_landmarks:
                mp_draw.draw_landmarks(
                    video_frame,
                    hand,
                    mp_hand.HAND_CONNECTIONS,
                    mp_styles.get_default_hand_landmarks_style(),
                    mp_styles.get_default_hand_connections_style()
                )
                index_tip = hand.landmark[8]
                x_pos = int(index_tip.x * frame_width)
                if x_pos > frame_width // 2 + 40:
                    cv2.putText(video_frame, "Accelerate", (460, 70), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 255, 0), 3)
                    pyautogui.keyDown('right')
                    pyautogui.keyUp('left')
                elif x_pos < frame_width // 2 - 40:
                    cv2.putText(video_frame, "Brake", (460, 70), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (0, 0, 255), 3)
                    pyautogui.keyDown('left')
                    pyautogui.keyUp('right')
                else:
                    pyautogui.keyUp('left')
                    pyautogui.keyUp('right')
        cv2.line(video_frame, (frame_width // 2, 0), (frame_width // 2, frame_height), (0, 255, 0), 2)
        current_time = time.time()
        fps = 1 / (current_time - previous_time + 1e-5)
        previous_time = current_time
        cv2.putText(video_frame, f'FPS: {int(fps)}', (20, 70), cv2.FONT_HERSHEY_SIMPLEX, 1.2, (255, 255, 0), 3)
        cv2.imshow("Gesture-Based Driving Control", video_frame)
        if cv2.waitKey(1) & 0xFF == 27:
            break
camera.release()
cv2.destroyAllWindows()
